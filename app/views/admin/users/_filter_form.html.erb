<%= search_form_for @q, url: admin_users_path, method: :get, html: {class: "filter-form"} do |f| %>
  <div class="row g-3">
    <!-- Search Input -->
    <div class="col-lg-4 col-md-6">
      <div class="form-group">
        <label class="form-label">
          <i class="fas fa-search me-1"></i>
          <%= t(".search_label") %>
        </label>
        <div class="input-group">
          <%= f.text_field :name_or_email_cont,
              placeholder: t(".search_placeholder"),
              class: "form-control search-input" %>
          <% if params.dig(:q, :name_or_email_cont).present? %>
            <button type="button" class="btn btn-outline-secondary clear-search" title="<%= t(".clear_search") %>">
              <i class="fas fa-times"></i>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Status Filter -->
    <div class="col-lg-3 col-md-6">
      <div class="form-group">
        <label class="form-label">
          <i class="fas fa-toggle-on me-1"></i>
          <%= t(".status_label") %>
        </label>
        <%= f.select :confirmed_at_null,
            options_for_select([
              [t(".status_all"), nil],
              [t(".status_inactive"), true],
              [t(".status_active"), false]
            ], params.dig(:q, :confirmed_at_null)),
            {},
            {class: "form-select status-select"} %>
      </div>
    </div>

    <!-- Course Filter -->
    <div class="col-lg-3 col-md-6">
      <div class="form-group">
        <label class="form-label">
          <i class="fas fa-graduation-cap me-1"></i>
          <%= t(".course_label") %>
        </label>
        <%= f.select :course_supervisors_course_id_eq,
            options_for_select([[t(".course_all"), nil]] + @courses.map {|course| [course.name, course.id]}, params.dig(:q, :user_courses_course_id_eq)),
            {},
            {class: "form-select course-select"} %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="col-lg-2 col-md-6">
      <div class="form-group">
        <label class="form-label d-block">&nbsp;</label>
        <div class="btn-group w-100" role="group">
          <%= f.submit t(".apply"),
              class: "btn btn-primary apply-btn" %>
          <% if params[:q].present? %>
            <%= link_to admin_users_path,
                class: "btn btn-outline-secondary reset-btn",
                title: t(".reset_filters") do %>
              <i class="fas fa-undo"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
