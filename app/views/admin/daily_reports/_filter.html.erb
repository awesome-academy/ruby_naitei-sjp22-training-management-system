<div class="card p-3 mb-4">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-xs-8">
        <%= search_form_for @q, url: admin_daily_reports_path, method: :get, html: {class: "form-inline"} do |f| %>
          <%= f.select :course_id_eq, options_for_select(Course.all.map {|c| [c.name, c.id]}, params.dig(:q, :course_id_eq)),
                       {prompt: t("shared.filter.select_course_placeholder")}, {class: "form-control form-select"} %>

          <%= f.select :user_id_eq, options_for_select(User.trainee.map {|u| [u.name, u.id] }, params.dig(:q, :user_id_eq)),
                       {prompt: t("shared.filter.select_user_placeholder")}, {class: "form-control form-select"} %>

          <%= f.date_field :created_at_day_eq, value: params.dig(:q, :created_at_day_eq), class: "form-control date-picker" %>

          <button class="btn btn-primary" type="submit"><%= t("shared.filter.apply_filter") %></button>
        <% end %>
      </div>
    </div>
  </div>
</div>
