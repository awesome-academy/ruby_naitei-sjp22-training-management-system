<%= search_form_for @q, url: admin_admin_users_path, method: :get, html: {class: "filter-form", role: "form"} do |f| %>
  <div class="row">
    <div class="col-md-7">
      <div class="form-group">
        <label><%= t(".search_by") %></label>
        <div class="input-group">
          <span class="input-group-addon"><%= t(".name") %></span>
          <%= f.search_field :name_or_email_cont,
                             class: "form-control",
                             placeholder: t(".search_placeholder") %>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="form-group">
        <label><%= t(".status") %></label>
        <%= f.select :confirmed_at_null,
            options_for_select([
              [t(".status_all"), nil],
              [t(".status_inactive"), true],
              [t(".status_active"), false]
            ], params.dig(:q, :confirmed_at_null)),
            {},
            {class: "form-select status-select"} %>
      </div>
    </div>

    <div class="col-md-3">
      <div class="form-group filter-action-buttons-group">
        <label>&nbsp;</label>
        <div class="filter-action-buttons">
          <%= f.submit t(".apply_button"), class: "btn btn-primary width-fit" %>
          <%= link_to t(".clear_filter_button"), admin_admin_users_path, class: "btn btn-default" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
