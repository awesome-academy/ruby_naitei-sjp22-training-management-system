<div class="course-dashboard">
  <h2><%= t(".course_dashboard_title") %></h2>
  <div class="row filter-form">
    <div class="col-md-6">
      <%= search_form_for @q, url: root_path, method: :get, class: "form-inline" do |f| %>
        <div class="input-group">
          <%= f.select :status_eq,
                        options_for_select(status_filter_options, params.dig(:q, :status_eq)),
                        class: "form-control" %>
          <span class="input-group-btn">
            <%= f.submit t(".apply"), class: "btn btn-primary" %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

    <div class="row">
      <% if @courses.any? %>
        <%= render partial: "courses/course_card", locals: {course: @courses} %>
      <% else %>
        <div class="col-12">
          <p class="text-muted"><%= t(".no_courses_found") %></p>
        </div>
      <% end %>
    </div>

  <div class="text-center mt-4">
    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > Settings.allowed_pagy %>
  </div>
</div>
